{
  "id": "P0202",
  "title": "이정표의 등급",
  "kind": "function",
  "entry": "solution",
  "enemy": { "name": "갈래 새싹", "sprite": "monster_fork_sprout", "attack": 20 },
  "requires": ["scroll.branch"],
