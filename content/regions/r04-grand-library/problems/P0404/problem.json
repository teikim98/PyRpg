  "tests": [
    {"args": "('  The_Lost_Book ',)", "expect": "'the lost book'", "public": true, "note": "기본 동작"},
    {"args": "('MAP',)", "expect": "'map'", "public": true, "note": "공백·밑줄 없음"},
    {"args": "('x',)", "expect": "'x'", "note": "경계: 길이 1, 이미 깨끗함"},
    {"args": "('   A   ',)", "expect": "'a'", "note": "경계: 공백 사이 글자 하나"},
    {"args": "('a_b_c_d',)", "expect": "'a b c d'", "note": "밑줄 여러 개"},
    {"args": "(' Ancient Rune_Tome',)", "expect": "'ancient rune tome'", "note": "공백과 밑줄이 섞임"},
    {"args": "('clean title',)", "expect": "'clean title'", "note": "이미 깨끗한 제목"},
    {"args": "('  Time_Stop_Rune_Time_Stop_Rune_Time_Stop_Rune_Time_Stop_Rune_Time_Stop_Rune_Time_Stop_Rune_Time_Stop_Rune_Time_Stop_Rune  ',)", "expect": "'time stop rune time stop rune time stop rune time stop rune time stop rune time stop rune time stop rune time stop rune'", "note": "경계: 길이 100 가까이"}
  ],
  "variants": [
    {
