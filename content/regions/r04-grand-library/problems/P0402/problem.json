        {"args": "('scroll',)", "expect": "False", "public": true, "note": "기본 동작"},
        {"args": "('xX',)", "expect": "False", "note": "경계: 길이 2, 대소문자만 다름"},
        {"args": "('MadaM',)", "expect": "True", "note": "대소문자 그대로 대칭"},
