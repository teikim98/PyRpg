  "tests": [
    {"args": "('level',)", "expect": "True", "public": true, "note": "기본 동작: 거울 제목"},
    {"args": "('book',)", "expect": "False", "public": true, "note": "기본 동작: 아님"},
    {"args": "('a',)", "expect": "True", "note": "경계: 길이 1"},
    {"args": "('Level',)", "expect": "False", "note": "대소문자가 다르면 아님"},
    {"args": "('abBA',)", "expect": "False", "note": "대소문자를 섞으면 아님"},
    {"args": "('ab',)", "expect": "False", "note": "경계: 길이 2, 다른 글자"},
    {"args": "('RaceCaR',)", "expect": "False", "note": "대소문자 그대로 대칭"},
    {"args": "('abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXXWVUTSRQPONMLKJIHGFEDCBAzyxwvutsrqponmlkjihgfedcba',)", "expect": "True", "note": "경계: 길이 100 거울 제목"},
    {"args": "('abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYWVUTSRQPONMLKJIHGFEDCBAzyxwvutsrqponmlkjihgfedcba',)", "expect": "False", "note": "경계: 길이 100, 한가운데 한 글자만 다름"}
  ],
  "variants": [
