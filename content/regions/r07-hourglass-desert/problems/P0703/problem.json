  "tests": [
    {"args": "(4,)", "expect": "6", "public": true, "note": "기본 동작"},
    {"args": "(1,)", "expect": "0", "note": "경계: n = 1(안쪽 반복이 한 번도 돌지 않음)"},
    {"args": "(2,)", "expect": "1", "note": "n = 2"},
    {"args": "(10,)", "expect": "45", "note": "n = 10"},
    {"args": "(1000,)", "expect": "499500", "note": "n = 1000(그대로 돌려도 끝나는 크기)"},
    {"args": "(100000,)", "expect": "4999950000", "note": "n = 100,000(그대로 돌리면 50억 번)"},
    {"args": "(999999999,)", "expect": "499999998500000001", "note": "실수로 나누면 끝자리가 틀어지는 큰 n"},
    {"args": "(1000000000,)", "expect": "499999999500000000", "note": "경계: n = 10억"}
  ],
  "variants": [
