{
  "id": "P0711",
  "title": "눈금 바꾸기",
  "kind": "function",
  "entry": "solution",
  "enemy": {"name": "그림자 바늘 게", "sprite": "monster_sundial_crab", "attack": 20},
  "requires": ["scroll.remainder"],
  "concept": "scroll.remainder",
  "boss": false,
  "timeLimitMs": 2000,
  "estimatedMinutes": 9,
  "tests": [
    {"args": "('1011', 2, 8)", "expect": "'13'", "public": true, "note": "기본 동작"},
    {"args": "('0', 10, 2)", "expect": "'0'", "note": "경계: 값이 0"},
    {"args": "('FF', 16, 2)", "expect": "'11111111'", "note": "16진법 → 2진법"},
    {"args": "('255', 10, 16)", "expect": "'FF'", "note": "10 이상인 숫자는 글자로"},
    {"args": "('A', 11, 10)", "expect": "'10'", "note": "11진법의 A"},
    {"args": "('1', 2, 16)", "expect": "'1'", "note": "경계: 한 자리"},
    {"args": "('12', 3, 3)", "expect": "'12'", "note": "같은 진법"},
    {"args": "('7B', 16, 7)", "expect": "'234'", "note": "16진법 → 7진법"},
    {"args": "('1000', 10, 12)", "expect": "'6B4'", "note": "12진법(가운데 자리가 B)"},
    {"args": "('DE0B6B3A7640000', 16, 10)", "expect": "'1000000000000000000'", "note": "경계: 가장 큰 값(10^18)"},
    {"args": "('1000000000000000000', 10, 16)", "expect": "'DE0B6B3A7640000'", "note": "경계: 가장 큰 값을 16진법으로"},
    {"args": "('1000000000000000000', 10, 2)", "expect": "'110111100000101101101011001110100111011001000000000000000000'", "note": "경계: 가장 긴 결과(2진법 60자리)"}
  ],
